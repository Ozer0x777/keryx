# Keryx avec Docker : toutes les variables de deploy/docker/.env.
#
# Ce fichier est un MODÈLE DE LECTURE. Le vrai .env est écrit par ./install.sh (clé maîtresse et mots de passe
# aléatoires) ; ne pas copier ce modèle à la main. Règles :
#   - ne jamais laisser une variable vide (« KERYX_SMTP_PORT= » fait échouer le démarrage) : la commenter ;
#   - après une modification : « docker compose up -d » (recrée les conteneurs concernés) ;
#   - une variable du terminal l'emporte sur .env pour « docker compose » : ne pas exporter de KERYX_… dans le shell.

# ------------------------------------------------------------------ déploiement
COMPOSE_PROJECT_NAME=keryx
# Profils démarrés, séparés par des virgules : antivirus, sso, objets, sauvegarde. Vide : aucun.
# Pour en ajouter un : l'écrire ici, puis relancer ./install.sh (il crée les secrets et réglages du profil).
COMPOSE_PROFILES=

# Nom de domaine de Keryx, tel que tapé dans le navigateur et dans le <hook_url> de Wazuh.
KERYX_DOMAIN=keryx.exemple.eu
# acme : certificat automatique ; fourni : certs/keryx.crt et certs/keryx.key ; local : essai sur une machine.
KERYX_HTTPS_MODE=acme

# Mode acme : adresse de l'annuaire ACME de l'autorité CHOISIE (pas de valeur par défaut, voir
# docs/deploiement-docker.md), courriel du compte, et liaison de compte externe si l'autorité l'exige.
#KERYX_ACME_CA=https://…/directory
#KERYX_ACME_EMAIL=soc@exemple.eu
#KERYX_ACME_EAB_KID=…
#KERYX_ACME_EAB_HMAC=…

# Ports et adresse d'écoute sur l'hôte. À ne définir que s'ils diffèrent de 80, 443 et « toutes les adresses ».
# Ne JAMAIS écrire KERYX_HTTPS_PORT=443 : l'adresse publique porterait « :443 » et ne correspondrait plus au navigateur.
#KERYX_HTTP_PORT=8080
#KERYX_HTTPS_PORT=8443
#KERYX_LISTEN_ADDR=192.0.2.10

# Utilisateur du conteneur caddy (celui qui a lancé install.sh : il lit certs/ sans droit particulier ; jamais 0).
KERYX_CADDY_UID=1000
KERYX_CADDY_GID=1000

# Trois premiers octets des deux sous-réseaux du reverse proxy (.0/29 et .8/29). À changer en cas de conflit avec
# un réseau existant, puis « docker compose up -d --force-recreate ».
#KERYX_NET_PREFIX=172.31.240

# ------------------------------------------------------------------ secrets (écrits par install.sh)
# Clé maîtresse (« keryx gen-key »). PERDUE = secrets TOTP, clés VirusTotal, comptes d'indexeur Wazuh, pièces du
# stockage objet et sauvegardes définitivement illisibles. La conserver hors de cette machine.
KERYX_SECRET_KEY=…
POSTGRES_PASSWORD=…

# ------------------------------------------------------------------ pare-feu applicatif (Coraza, OWASP CRS)
# blocage (défaut) : une requête jugée malveillante est refusée (403). detection : rien n'est bloqué, chaque règle
# déclenchée est journalisée (docker compose logs caddy). off : dépannage seulement (PDIS IV.3.13.g le demande).
#KERYX_WAF=blocage

# ------------------------------------------------------------------ sorties réseau de Keryx
# true : le conteneur keryx ne joint que caddy, postgres et les services des profils. false : il peut sortir
# (SMTP, autorité d'horodatage, indexeur Wazuh, syslog, VirusTotal) ; filtrer alors au pare-feu de l'hôte.
KERYX_SORTIE_FERMEE=true
# Recherche d'empreinte sur VirusTotal (service hors UE, dérogation ADR-0022). Demande KERYX_SORTIE_FERMEE=false.
# Dans un déploiement visant la qualification PDIS : false (PDIS IV.3.7.k, voir docs/deploiement-docker.md).
KERYX_VIRUSTOTAL_ENABLED=false
#KERYX_VIRUSTOTAL_PROXY=http://mandataire.interne:3128
#KERYX_VIRUSTOTAL_USER_LIMIT=4
#KERYX_VIRUSTOTAL_CLIENT_LIMIT=20

# ------------------------------------------------------------------ réglages facultatifs de Keryx (docs/exploitation.md)
#KERYX_SMTP_HOST=smtp.exemple.eu
#KERYX_SMTP_PORT=587
#KERYX_SMTP_TLS=starttls
#KERYX_SMTP_USER=keryx
#KERYX_SMTP_PASSWORD=…
#KERYX_SMTP_FROM=keryx@exemple.eu
#KERYX_SYSLOG_HOST=wazuh-manager.interne
#KERYX_SYSLOG_PORT=514
#KERYX_MIN_RULE_LEVEL=7
#KERYX_DEDUP_MINUTES=15
#KERYX_RETENTION_MONTHS=12
#KERYX_SESSION_HOURS=8
#KERYX_LOGIN_USER_LIMIT=10
#KERYX_LOGIN_IP_LIMIT=30
#KERYX_RATE_LIMIT_BACKEND=db
#KERYX_NOTIFY_RETRY_S=300
# Astreinte (ADR-0032) : période de la tâche d'escalade et de relance des webhooks, en secondes (0 = coupée).
#KERYX_ASTREINTE_TICK_S=60
#KERYX_QUARANTINE_PASSWORD=infected
# Taille maximale d'une requête ordinaire : appliquée par caddy ET par Keryx (même valeur, en octets).
#KERYX_MAX_BODY_BYTES=2097152
# Image de Keryx. Sans KERYX_IMAGE : construite sur cette machine depuis le dépôt. Avec KERYX_IMAGE : image publiée
# à chaque version, signée (cosign, signature sans clé liée au dépôt GitHub) ; install.sh la récupère, vérifie
# toujours sa signature et écrit ici KERYX_VERSION figée sur l'empreinte vérifiée (X.Y.Z@sha256:…).
# KERYX_VERSION : numéro de version sans « v », éventuellement suivi de @sha256:<empreinte>.
#KERYX_IMAGE=ghcr.io/ozer0x777/keryx
#KERYX_VERSION=0.12.0
# Horodatage RFC 3161 : le fichier d'autorités se dépose dans ./confiance (monté dans /etc/keryx/confiance).
#KERYX_TSA_URL=https://…
#KERYX_TSA_CA_FILE=/etc/keryx/confiance/tsa-ca.pem
#KERYX_TSA_USER=…
#KERYX_TSA_PASSWORD=…
#KERYX_TSA_BEARER=…
#KERYX_TSA_CLIENT_CERT=/etc/keryx/confiance/tsa-client.crt
#KERYX_TSA_CLIENT_KEY=/etc/keryx/confiance/tsa-client.key
#KERYX_TSA_POLICY_OID=…
#KERYX_WAZUH_TIME_FIELD=@timestamp
#KERYX_WAZUH_CONTEXT_USER_LIMIT=20
#KERYX_WAZUH_CONTEXT_CLIENT_LIMIT=60
#KERYX_WAZUH_ALLOW_LOOPBACK=false
# Parc d'agents Wazuh : relevé de l'API de chaque manager toutes les N secondes (0 = à la demande). Sortie réseau requise.
#KERYX_WAZUH_AGENTS_POLL_S=300
# Autorités reconnues par Keryx pour ses appels HTTPS sortants. Par défaut celles du système. Avec une autorité
# privée : ./confiance/ca-bundle.pem (autorités du système SUIVIES de l'autorité privée ; install.sh le fait
# en mode local, et en mode fourni si certs/ca.crt existe).
#KERYX_CA_BUNDLE=/etc/keryx/confiance/ca-bundle.pem

# ------------------------------------------------------------------ profil antivirus
#KERYX_CLAMAV_HOST=clamav
#KERYX_CLAMAV_PORT=3310
# true : ClamAV ne peut plus télécharger ses signatures (database.clamav.net) ; il garde celles de l'image.
#KERYX_CLAMAV_SORTIE_FERMEE=false

# ------------------------------------------------------------------ profil sso (Keycloak)
# Nom de domaine de Keycloak, distinct de celui de Keryx. Le définir active son site dans caddy.
#KERYX_SSO_DOMAIN=sso.exemple.eu
# Compte d'amorçage de Keycloak : à remplacer par un administrateur nominatif, puis à supprimer.
#KEYCLOAK_ADMIN_USER=admin-keycloak
#KEYCLOAK_ADMIN_PASSWORD=…
#KEYCLOAK_DB_PASSWORD=…
# Secrets des clients OpenID Connect « keryx » des realms soc et clients (lus à l'import des realms).
#KERYX_OIDC_SECRET_SOC=…
#KERYX_OIDC_SECRET_CLIENTS=…
# Une seule ligne, entre guillemets simples. « roles » borne ce que chaque realm peut authentifier (ADR-0017).
#KERYX_OIDC_PROVIDERS='[{"name":"soc","label":"Compte SOC","issuer":"https://sso.exemple.eu/realms/soc","client_id":"keryx","client_secret":"…","roles":["manager","analyst"]},{"name":"clients","label":"Compte client","issuer":"https://sso.exemple.eu/realms/clients","client_id":"keryx","client_secret":"…","roles":["client"]}]'
# true : seul l'Admin garde une connexion locale (accès de secours).
#KERYX_OIDC_ENFORCE=true
#KERYX_OIDC_REQUIRED_ACR=…
# Adresses autorisées à ouvrir la console d'administration de Keycloak (/admin, realm master), séparées par des
# espaces. Par défaut : les plages privées. À resserrer sur la zone d'administration.
#KERYX_ADMIN_CIDRS=10.20.30.0/24

# ------------------------------------------------------------------ profil objets (Garage)
#GARAGE_RPC_SECRET=…
# Écrits par install.sh après l'initialisation de Garage (deploy/garage/init.sh) :
#KERYX_STORAGE=s3
#KERYX_S3_ENDPOINT=http://garage:3900
#KERYX_S3_ALLOW_HTTP=true
#KERYX_S3_BUCKET=keryx-pieces
#KERYX_S3_REGION=garage
#KERYX_S3_ACCESS_KEY=…
#KERYX_S3_SECRET_KEY=…
#KERYX_S3_PREFIX=keryx

# ------------------------------------------------------------------ profil sauvegarde
# Intervalle entre deux « keryx backup », en secondes, et nombre d'archives gardées dans le volume.
#KERYX_BACKUP_INTERVAL_S=86400
#KERYX_BACKUP_KEEP=14
