# Suite e2e à travers le pare-feu applicatif du kit Docker (E2E_WAF=detection ou blocage) : mêmes fichiers de règles
# que le kit (deploy/docker/caddy/waf, monté sur /etc/caddy), en HTTP local devant Keryx lancé par le harnais.
{
	admin off
	persist_config off
	auto_https off
	order coraza_waf first
	log {
		output stdout
		format json
	}
}

:{$E2E_PORT} {
	import /etc/caddy/waf/{$KERYX_WAF}.caddy
	request_body {
		max_size 81MiB
	}
	reverse_proxy 127.0.0.1:{$E2E_UPSTREAM}
}

# Keycloak derrière le même pare-feu (scénario 60-sso, E2E_KEYCLOAK pointant sur ce port) : même fichier de règles
# que le site Keycloak du kit (deploy/docker/caddy/sso-actif.caddy). Sans Keycloak, ce site ne sert à rien.
:{$E2E_KC_PORT:8999} {
	import /etc/caddy/waf/{$KERYX_WAF}.caddy
	reverse_proxy {$E2E_KC_UPSTREAM:127.0.0.1:1}
}
